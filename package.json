{
  "name": "oliviacode",
  "version": "0.10.0",
  "private": true,
  "description": "OliviaCode — 本地优先的 AI 编程工作站",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @olivia/web run dev",
    "dev:desktop": "node scripts/dev-desktop.cjs",
    "build:web": "npm --workspace @olivia/web run build",
    "build:main": "npm --workspace @olivia/desktop run build",
    "build": "npm run build:web && npm run build:main",
    "start": "npm run build && node scripts/electron-run.cjs apps/desktop",
    "icon": "powershell -ExecutionPolicy Bypass -File scripts/build-icon.ps1",
    "package:win": "npm run icon && npm run build && node scripts/package-win.cjs",
    "typecheck": "tsc -p apps/web/tsconfig.json && tsc -p apps/desktop/tsconfig.json",
    "shot": "node scripts/electron-run.cjs scripts/capture.cjs",
    "shot:pages": "node scripts/electron-run.cjs scripts/capture-pages.cjs",
    "shot:theme": "node scripts/electron-run.cjs scripts/shot-theme.cjs",
    "test:exec": "node apps/desktop/dist/exec-selftest.cjs",
    "test:wf": "node apps/desktop/dist/wf-selftest.cjs",
    "test:sched": "node apps/desktop/dist/scheduler-selftest.cjs",
    "test:mcp": "node apps/desktop/dist/mcp-selftest.cjs",
    "test:skill": "node apps/desktop/dist/skill-selftest.cjs",
    "test:usage": "node apps/desktop/dist/usage-selftest.cjs",
    "test:memory": "node apps/desktop/dist/memory-selftest.cjs",
    "test:provider": "node apps/desktop/dist/provider-selftest.cjs",
    "test:guards": "node apps/desktop/dist/guards-selftest.cjs",
    "test:vision": "node scripts/vision-selftest.cjs",
    "test": "npm run build:main && npm run test:exec && npm run test:wf && npm run test:sched && npm run test:mcp && npm run test:skill && npm run test:usage && npm run test:memory && npm run test:provider && npm run test:guards && npm run test:vision",
    "e2e:wf": "node scripts/electron-run.cjs scripts/wf-e2e.cjs",
    "e2e:ui": "node scripts/electron-run.cjs scripts/ui-e2e.cjs",
    "e2e:preview": "node scripts/electron-run.cjs scripts/preview-e2e.cjs",
    "e2e:m8": "node scripts/electron-run.cjs scripts/m8-e2e.cjs",
    "smoke:ui": "node scripts/electron-run.cjs scripts/ui-smoke.cjs",
    "shot:m8": "node scripts/electron-run.cjs scripts/shot-m8.cjs",
    "mock:llm": "node scripts/mock-llm.cjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "electron": "33.2.0",
    "esbuild": "0.21.5",
    "ffmpeg-static": "^5.3.0",
    "typescript": "5.6.3"
  }
}
