{
  "name": "oliviacode",
  "version": "0.5.0",
  "private": true,
  "description": "OliviaCode — 本地优先的 AI 编程工作站",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @olivia/web run dev",
    "build:web": "npm --workspace @olivia/web run build",
    "build:main": "npm --workspace @olivia/desktop run build",
    "build": "npm run build:web && npm run build:main",
    "start": "npm run build && electron apps/desktop",
    "typecheck": "tsc -p apps/web/tsconfig.json && tsc -p apps/desktop/tsconfig.json",
    "shot": "electron scripts/capture.cjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "electron": "33.2.0",
    "esbuild": "0.21.5",
    "typescript": "5.6.3"
  }
}
