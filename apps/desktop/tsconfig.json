{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@olivia/core": ["../../packages/core/src/index.ts"],
      "@olivia/exec": ["../../packages/exec/src/index.ts"]
    }
  },
  "include": ["src"]
}
